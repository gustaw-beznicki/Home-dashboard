# Clerk publishable key for production builds. Public by design — it's embedded in
# the client bundle and is not a credential. Committed so CI builds have it; without
# it the bundle ships `publishableKey: undefined` and the login screen breaks.
#
# Local development overrides this via .env.local (gitignored), which Vite loads at
# higher precedence in every mode — so local work uses the Clerk dev instance.
VITE_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsuaG9tZS1kYXNoYm9hcmQuYXBwJA
