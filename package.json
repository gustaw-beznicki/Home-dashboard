{
  "name": "home-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:worker": "wrangler dev",
    "dev:no-auth": "vite build && wrangler dev --var DEV_NO_AUTH:true --var ENVIRONMENT:development",
    "dev-no-auth": "npm run dev:no-auth",
    "db:migrate": "wrangler d1 migrations apply home-dashboard-db",
    "db:migrate:local": "wrangler d1 migrations apply home-dashboard-db --local",
    "db:seed:local": "wrangler d1 execute home-dashboard-db --local --file scripts/seed-local.sql"
  },
  "dependencies": {
    "better-auth": "1.6.25",
    "lucide-react": "^1.27.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "playwright": "^1.62.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "vite": "^6.0.3",
    "vitest": "^2.1.8",
    "wrangler": "^4.114.0"
  }
}
