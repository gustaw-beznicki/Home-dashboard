{
  "name": "home-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:worker": "wrangler dev",
    "dev:no-auth": "vite build && wrangler dev --var DEV_NO_AUTH:true --var ENVIRONMENT:development",
    "db:migrate": "wrangler d1 migrations apply home-dashboard-db",
    "db:migrate:local": "wrangler d1 migrations apply home-dashboard-db --local",
    "db:seed:local": "wrangler d1 execute home-dashboard-db --local --file scripts/seed-local.sql",
    "admin:list": "node scripts/grant-admin.mjs --list",
    "admin:grant": "node scripts/grant-admin.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "better-auth": "1.6.25",
    "lucide-react": "^1.27.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.0.1",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^30.0.0",
    "playwright": "^1.62.0",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.3.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  }
}
