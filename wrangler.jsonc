{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "home-dashboard",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "worker/index.js",
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "home-dashboard-db",
      "database_id": "4e5e084a-d1e5-4fcc-8390-35aeeb478021"
    }
  ],
  "vars": {
    // Public by design (it ships in the frontend bundle) — but the Worker needs it too:
    // authenticateRequest() 500s with "Publishable key is missing" without it.
    "CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsuaG9tZS1kYXNoYm9hcmQuYXBwJA",
    "CF_ACCESS_TEAM_DOMAIN": "https://withered-thunder-37cf.cloudflareaccess.com",
    "CF_ACCESS_AUD": "51bbecd6562d3569fb0e020b323413ee9126d47a101c1707b54a265ddabdac01",
    "ENVIRONMENT": "production"
  }
}
