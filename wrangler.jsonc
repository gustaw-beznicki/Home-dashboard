{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "home-dashboard",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "worker/index.js",
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "home-dashboard-db",
      "database_id": "4e5e084a-d1e5-4fcc-8390-35aeeb478021"
    }
  ],
  "vars": {
    // Better Auth needs this explicitly — it builds OAuth redirect URIs and the
    // trusted origin from it, and inferring it from the request is discouraged.
    // Not a secret: it's just the app's public hostname (ADR 0004, ADR 0005).
    "BASE_URL": "https://home-dashboard.app",
    "INVITE_EMAIL_FROM": "Home Dashboard <no-reply@home-dashboard.app>",
    "ENVIRONMENT": "production"
  }
}
